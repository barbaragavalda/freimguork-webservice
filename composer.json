{
  "name": "optisistem/freimguork-webservice",
  "description": "Webservice module for Freimgüork projects",
  "authors": [
    {
      "name": "Barbara Gavalda",
      "email": "bgb@optisistem.com"
    },
    {
      "name": "Toni Palanques",
      "email": "tpv@optisistem.com"
    }
  ],
  "repositories": [
    {
      "type": "vcs",
      "url": "git@bitbucket.org:optisistem/freimguork-core.git"
    },
    {
      "type": "vcs",
      "url": "git@bitbucket.org:optisistem/php-ref.git"
    }
  ],
  "require": {
    "php": "^8.5",
    "ext-gettext": "*",
    "ext-pdo": "*",
    "optisistem/freimguork-core": "dev-master || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Webservice\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Webservice\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "check-constraints": "php bin/check-sibling-constraints.php"
  },
  "minimum-stability": "dev"
}