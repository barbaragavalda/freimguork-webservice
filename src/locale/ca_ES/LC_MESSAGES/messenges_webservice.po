msgid "All fields are required."
msgstr "Tots els camps són obligatoris."

msgid "That email is already registered."
msgstr "Aquest email ja està registrat."

msgid "Invalid email or password."
msgstr "Email o contrasenya incorrectes."

msgid "Username must be 3-20 characters long and contain only letters, numbers, \"_\" or \".\""
msgstr "El nom d'usuari ha de tenir entre 3 i 20 caràcters i només pot contenir lletres, números, \"_\" o \".\""

msgid "That username is already taken."
msgstr "Aquest nom d'usuari ja està agafat."

msgid "Registration failed."
msgstr "El registre ha fallat."

msgid "Email is required."
msgstr "Cal l'email."

msgid "Your password reset code"
msgstr "El teu codi per recuperar la contrasenya"

msgid "Your password reset code is:"
msgstr "El teu codi per recuperar la contrasenya és:"

msgid "It expires in 15 minutes."
msgstr "Caduca en 15 minuts."

msgid "Invalid or expired code."
msgstr "Codi invàlid o caducat."

msgid "Enter a valid email address."
msgstr "Introdueix una adreça de correu vàlida."

msgid "Current password is incorrect."
msgstr "La contrasenya actual és incorrecta."

msgid "Unsupported language."
msgstr "Idioma no admès."

msgid "Password must be at least %d characters long."
msgstr "La contrasenya ha de tenir com a mínim %d caràcters."

msgid "Confirm your new email address"
msgstr "Confirma la teva nova adreça de correu"

msgid "Your confirmation code is:"
msgstr "El teu codi de confirmació és:"

msgid "Code is required."
msgstr "Cal el codi."

msgid "Your account's email is being changed"
msgstr "S'està canviant l'email del teu compte"

msgid "A request was made to change this account's email to:"
msgstr "S'ha sol·licitat canviar l'email d'aquest compte a:"

msgid "If this wasn't you, change your password immediately."
msgstr "Si no has estat tu, canvia la contrasenya immediatament."
