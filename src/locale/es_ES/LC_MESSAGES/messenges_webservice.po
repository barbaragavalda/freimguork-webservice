msgid "All fields are required."
msgstr "Todos los campos son obligatorios."

msgid "That email is already registered."
msgstr "Este email ya está registrado."

msgid "Invalid email or password."
msgstr "Email o contraseña incorrectos."

msgid "Username must be 3-20 characters long and contain only letters, numbers, \"_\" or \".\""
msgstr "El nombre de usuario debe tener entre 3 y 20 caracteres y solo puede contener letras, números, \"_\" o \".\""

msgid "That username is already taken."
msgstr "Ese nombre de usuario ya está en uso."

msgid "Registration failed."
msgstr "El registro ha fallado."

msgid "Email is required."
msgstr "El email es obligatorio."

msgid "Your password reset code"
msgstr "Tu código para recuperar la contraseña"

msgid "Your password reset code is:"
msgstr "Tu código para recuperar la contraseña es:"

msgid "It expires in 15 minutes."
msgstr "Caduca en 15 minutos."

msgid "Invalid or expired code."
msgstr "Código inválido o caducado."

msgid "Enter a valid email address."
msgstr "Introduce una dirección de correo válida."

msgid "Current password is incorrect."
msgstr "La contraseña actual es incorrecta."

msgid "Unsupported language."
msgstr "Idioma no soportado."
